# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=crown
POSTGRES_PASSWORD=crown_dev
POSTGRES_DB=crown
POSTGRES_PORT=5433

# Backend
DATABASE_URL=postgres://crown:crown_dev@localhost:5433/crown?sslmode=disable
TEST_DATABASE_URL=postgres://crown:crown_dev@localhost:5433/crown_test?sslmode=disable
API_ADDR=:8080
# Set to true in production (HTTPS) so the session cookie is never sent over plain HTTP
COOKIE_SECURE=false

# Frontend: leave empty in dev (Vite proxies to the API); set to the API origin in production
VITE_API_URL=
